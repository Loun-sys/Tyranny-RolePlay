DISCORD_TOKEN=вставьте_токен_бота
# Необязательно: ID тестового сервера ускоряет появление slash-команд.
DISCORD_GUILD_ID=
# Railway: подключите Volume к /app/data и оставьте это значение.
# Локально переменную можно не задавать.
TYRANNY_DATA_DIR=/app/data
TYRANNY_MASTER_ROLE_IDS=
TYRANNY_REGISTRATION_URL=https://имя.github.io/Tyranny-RolePlay/
# Необязательно: по умолчанию берётся archive.html рядом с адресом регистрации.
TYRANNY_ARCHIVE_URL=https://имя.github.io/Tyranny-RolePlay/archive.html
# Необязательно: закрытая мастерская; по умолчанию admin.html рядом с конструктором.
TYRANNY_ADMIN_URL=https://имя.github.io/Tyranny-RolePlay/admin.html
TYRANNY_PUBLIC_API_URL=https://ваш-сервис.up.railway.app
TYRANNY_WEB_ORIGIN=https://имя.github.io
TYRANNY_ENABLE_WEB=1
PORT=8080
